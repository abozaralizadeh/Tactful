{
  "name": "tactful",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A two-person chat where messages are rewritten to be calm before they are delivered.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abozaralizadeh/Tactful.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "stats": "tsx --env-file-if-exists=.env scripts/stats.ts",
    "load-test": "tsx scripts/load-test.ts",
    "rewrite-test": "tsx --env-file-if-exists=.env scripts/rewrite-test.ts"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
