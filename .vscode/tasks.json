{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "web: vite dev server",
      "type": "shell",
      "command": "npm run dev:web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:"
        }
      }
    },
    { "label": "test", "type": "shell", "command": "npm test", "group": "test" },
    { "label": "rewrite test (50 messages)", "type": "shell", "command": "npm run rewrite-test" }
  ]
}
