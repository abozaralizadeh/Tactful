# Copy to .env and change what you need. Never commit .env.

PORT=3000
HOST=127.0.0.1
# Behind a proxy, so the real client IP is used for rate limits: true (Caddy on this machine),
# or the proxy addresses to trust, for example 127.0.0.1 behind a local nginx
TRUST_PROXY=false

DB_PATH=data/tactful.db
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=5

# Which rewriter to use: fake (local rules, free), anthropic or azure (both paid, need a key)
REWRITER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Azure OpenAI: endpoint like https://<resource>.openai.azure.com, and the deployment name
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Optional second deployment, tried only when the first one fails
AZURE_OPENAI_FALLBACK_ENDPOINT=
AZURE_OPENAI_FALLBACK_API_KEY=
AZURE_OPENAI_FALLBACK_DEPLOYMENT=
REWRITE_TIMEOUT_MS=20000

# Policy knobs
RETENTION_DAYS=30
DRAFT_TTL_MINUTES=60
MAX_MESSAGE_CHARS=2000
MAX_TOPIC_CHARS=300
MAX_NAME_CHARS=40

# Abuse protection
DAILY_REWRITE_CAP=2000
# Most AI tokens (in plus out) per day across the service. 0 means no budget.
DAILY_TOKEN_BUDGET=0
RATE_REWRITES_PER_IP_PER_HOUR=60
RATE_CREATE_PER_HOUR=10
RATE_JOIN_PER_HOUR=20
RATE_DRAFT_PER_MINUTE=20
