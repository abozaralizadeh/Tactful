# Copy to .env and change what you need. Never commit .env.

PORT=3000
HOST=127.0.0.1
# Set to true when running behind Caddy so the real client IP is used for rate limits
TRUST_PROXY=false

DB_PATH=data/tactful.db
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=5

# Which rewriter to use: fake (local rules, free) or anthropic (paid, needs a key)
REWRITER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
REWRITE_TIMEOUT_MS=20000

# Policy knobs
RETENTION_DAYS=30
DRAFT_TTL_MINUTES=60
MAX_MESSAGE_CHARS=2000
MAX_TOPIC_CHARS=300
MAX_NAME_CHARS=40

# Abuse protection
DAILY_REWRITE_CAP=2000
RATE_CREATE_PER_HOUR=10
RATE_JOIN_PER_HOUR=20
RATE_DRAFT_PER_MINUTE=20
